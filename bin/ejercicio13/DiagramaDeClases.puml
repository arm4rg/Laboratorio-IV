/'Use class y abstract debido a que una clase en Java
Solo puede tener 1 clase Padre '/
@startuml Diagrama de Clases 
Title Sistema de Estudiantes

class Persona{
  - nombre: String
  - email: String
  - edad: int
  +getNombre(): String
  +getEmail(): String
  +getEdad(): int
  +mostrarInformacion(): void 
}

abstract class Curso{
  #nombreCurso: String
  #seccionCurso: char 
  #horarioCurso: String
  #mostrarInfoCurso(): void 
}

class Estudiante{
  -carné: long 
  -listaDeCursos[ ]: Curso 
  +getCarné(): long
  +getListaDeCursos(): Curso 
  +mostrarInfoEstudiante(): void 
}
Persona <--Estudiante
Curso <|-- Estudiante

@enduml
